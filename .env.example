# Default is from neon.tech postgres, feel free to change
DATABASE_URL=

# Optional for built-in caching: Get these from Upstash Redis console
REDIS_URL= 
REDIS_TOKEN=

# Clerk (required for auth). Restrict sign-ups to invitations in Clerk Dashboard.
# NEXT_PUBLIC_APP_URL is used as the base for Clerk invitation redirect URLs (production).
# NEXT_PUBLIC_APP_URL=https://your-domain.com