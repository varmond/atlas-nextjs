### Task 4.2: Create Support Access Request Component
**File:** `src/components/admin/support-access-form.tsx` (create new file)

```typescript
'use client';

import { useState } from 'react';

export function SupportAccessForm({ organizationId }: { organizationId: string }) {
  const [reason, setReason] = useState('');
  const [duration, setDuration] = useState(24);
  const [loading, setLoading] = useState(false);

  async function handleSubmit(e: React.FormEvent) {
    e.preventDefault();
    setLoading(true);

    try {
      const response = await fetch('/api/admin/support-access', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          organizationId,
          reason,
          durationHours: duration,
        }),
      });

      if (response.ok) {
        alert('Support access granted successfully');
        setReason('');
      } else {
        alert('Failed to grant support access');
      }
    } catch (error) {
      console.error('Error granting support access:', error);
      alert('An error occurred');
    } finally {
      setLoading(false);
    }
  }

  return (
    <form onSubmit={handleSubmit} className="space-y-4 max-w-md">
      <h3 className="text-lg font-semibold">Request Support Access</h3>
      
      <div>
        <label className="block text-sm font-medium text-gray-700">
          Reason (Required)
        </label>
        <textarea
          value={reason}
          onChange={(e) => setReason(e.target.value)}
          required
          rows={3}
          className="mt-1 block w-full rounded-md border-gray-300 shadow-sm"
          placeholder="Describe why you need access..."
        />
      </div>

      <div>
        <label className="block text-sm font-medium text-gray-700">
          Duration (Hours)
        </label>
        <select
          value={duration}
          onChange={(e) => setDuration(Number(e.target.value))}
          className="mt-1 block w-full rounded-md border-gray-300 shadow-sm"
        >
          <option value={4}>4 hours</option>
          <option value={8}>8 hours</option>
          <option value={24}>24 hours</option>
          <option value={72}>72 hours</option>
        </select>
      </div>

      <button
        type="submit"
        disabled={loading || !reason}
        className="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 disabled:opacity-50"
      >
        {loading ? 'Requesting...' : 'Request Access'}
      </button>
    </form>
  );
}
```

